# Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-3.5-flash
VISION_MODEL_NAME=gemini-3.5-flash
AUDIO_TRANSCRIPTION_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
GEMINI_REQUEST_TIMEOUT=35
AI_CONCURRENCY=6
AI_RETRY_ATTEMPTS=2

# Application & Session Security
SECRET_KEY=generate_a_strong_random_secret_for_production
FLASK_DEBUG=false
SESSION_COOKIE_SECURE=false

# PostgreSQL Database & Connection Pool
DATABASE_URL=postgresql://username:password@hostname:5432/database_name
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=6
DB_POOL_TIMEOUT=10.0

# Rate Limiting
CHAT_RATE_LIMIT=40

# Payment & Optional Third-party Services
PREMIUM_PRICE=20000
PREMIUM_DURATION_DAYS=30
BANK_NAME=MB BANK
BANK_ACCOUNT_NUMBER=your_bank_account_number
BANK_ACCOUNT_NAME=YOUR NAME
BANK_BIN=970422
SEPAY_WEBHOOK_API_KEY=your_sepay_key_here
OPENWEATHER_API_KEY=your_openweather_key_here
